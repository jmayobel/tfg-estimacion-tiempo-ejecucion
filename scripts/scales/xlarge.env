# Workload scale: xlarge (~2x large)
# Tail point on the scaling curve — exercises thermal / memory pressure.
# Total runtime may exceed 1.5h on slower hardware.
WORKLOAD_SCALE=xlarge

OLLAMA_REQUESTS=80
BUSQUEDA_REQUESTS=3000
IPERF_BYTES=800G
SYSBENCH_EVENTS=600000
NETWORK_PING_COUNT=260
PYTORCH_GPU_EPOCHS=240
STRESSNG_OPS=10000
FFMPEG_VIDEO_LENGTH=3600
K6_ITERATIONS=1200
FIO_SIZE=12G
ZIP_ROUNDS=5
BUILD_ROUNDS=30
REDIS_REQUESTS=10000000
