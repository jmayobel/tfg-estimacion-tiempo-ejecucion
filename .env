# ============================================================
# Dataset Creator - Configuration
# Copy this file to .env and adjust as needed
# ============================================================

# Sampling interval in seconds (matches Prometheus scrape interval)
SAMPLE_INTERVAL=2

# Hostname label for the dataset (identifies this machine)
# For Azure VMs, use descriptive names: azure-cpu-01, azure-gpu-01, azure-nc6-east
# For local machines: windows-rtx3060, macos-m4-pro, etc.
HOSTNAME_LABEL=windows-rtx5070ti

# Prometheus URL
PROMETHEUS_URL=http://localhost:9090

# Seconds to wait after starting a service before collecting metrics
WAIT_AFTER_START=10

# ============================================================
# Per-service workload sizes (services run until workload completes)
# Execution time is now measured naturally, not predetermined.
# MAX_SERVICE_TIMEOUT is a safety net to kill hung services.
# ============================================================
MAX_SERVICE_TIMEOUT=7200

OLLAMA_REQUESTS=40
BUSQUEDA_REQUESTS=1500
IPERF_BYTES=400G
SYSBENCH_EVENTS=300000
NETWORK_PING_COUNT=130
PYTORCH_GPU_EPOCHS=120
STRESSNG_OPS=5000
FFMPEG_VIDEO_LENGTH=1800
K6_ITERATIONS=600
FIO_SIZE=6G
ZIP_ROUNDS=3
BUILD_ROUNDS=15
REDIS_REQUESTS=5000000

# ============================================================
# Service-specific settings
# ============================================================

# Busqueda Caminos API settings
# BUSQUEDA_URL=http://localhost:5005/process
# Set to a valid instance file path (use quotes if the path contains spaces)
BUSQUEDA_INSTANCE_FILE="E-VRPTW Instances/prueba1_5nodos_v2.txt"

# Ollama model to benchmark
OLLAMA_MODEL=llama3.2:1b

# ============================================================
# Azure VM Specific (Optional)
# ============================================================
# These are informational only - not used by scripts directly
# Document your Azure VM configuration for reference

# AZURE_VM_SIZE=Standard_D4s_v3
# AZURE_REGION=eastus
# AZURE_RESOURCE_GROUP=dataset-creator-rg
