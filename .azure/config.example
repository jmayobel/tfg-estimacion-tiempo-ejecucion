# ============================================================================
# Azure VM Configuration for Dataset Creator
# ============================================================================
# Copy this file to .azure/config and fill in your Azure details
# This file should NOT be committed to version control
# ============================================================================

# Azure Resource Configuration
AZURE_RESOURCE_GROUP=dataset-creator-rg
AZURE_LOCATION=westeurope
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# VM Configuration
AZURE_VM_NAME=dataset-creator-vm-01
AZURE_VM_SIZE=Standard_D4s_v3  # CPU-only VM (4 vCPU, 16 GB RAM) - fits Azure for Students quota
# For an AMD CPU data point: Standard_D4as_v4 (4 vCPU, 16 GB)
# For a GPU run: Standard_NC4as_T4_v3 (Tesla T4) - REQUIRES quota request first

# SSH Configuration
SSH_USER=azureuser
SSH_KEY_PATH=~/.ssh/id_rsa
SSH_PUBLIC_KEY_PATH=~/.ssh/id_rsa.pub

# Dataset Creator Configuration
HOSTNAME_LABEL=azure-cpu-01
# Use descriptive names like: azure-cpu-01, azure-gpu-t4-01, azure-cpu-amd-01

# Optional: Multiple VMs
# Uncomment and configure additional VMs if deploying multiple instances

# VM 2 (GPU - quota request required for NCASv3_T4 family)
# AZURE_VM_NAME_2=dataset-creator-gpu-01
# AZURE_VM_SIZE_2=Standard_NC4as_T4_v3
# HOSTNAME_LABEL_2=azure-gpu-t4-01

# VM 3 (AMD CPU - alternate architecture data point)
# AZURE_VM_NAME_3=dataset-creator-cpu-amd-01
# AZURE_VM_SIZE_3=Standard_D4as_v4
# HOSTNAME_LABEL_3=azure-cpu-amd-01

# ============================================================================
# Usage Notes
# ============================================================================
#
# 1. VM Size Selection (Azure for Students has a 6-vCPU regional cap):
#    - Standard_D2s_v3:        2 vCPU,  8 GB RAM           - Minimal (testing)
#    - Standard_D4s_v3:        4 vCPU, 16 GB RAM           - Recommended CPU default (Intel)
#    - Standard_D4as_v4:       4 vCPU, 16 GB RAM           - Recommended CPU alternate (AMD EPYC)
#    - Standard_D4ds_v4:       4 vCPU, 16 GB + local NVMe  - Better FIO numbers
#    - Standard_NC4as_T4_v3:   4 vCPU, 28 GB RAM, Tesla T4 - Recommended GPU (requires quota request)
#
#    NCv1 K80 SKUs (Standard_NC6/12/24) are retired and incompatible with
#    nvidia-driver-535; do not use.
#
# 2. Azure Regions:
#    - westeurope (recommended for Spain) - lowest latency, EU data residency
#    - northeurope, francecentral, swedencentral (other EU options)
#    - eastus, westus2 (US)
#    - See full list: az account list-locations -o table
#
# 3. GPU quota request (one-time):
#    Portal -> Subscriptions -> Usage + quotas -> Request increase
#    Family: Standard NCASv3_T4 Family   Region: West Europe   Limit: 4 vCPUs
#    Typically approved within 24h for student/academic projects.
#
# 4. Cost Estimation:
#    - Standard_D4s_v3:       ~$0.19/hour (~450 hours on $100 credit)
#    - Standard_D4as_v4:      ~$0.18/hour
#    - Standard_NC4as_T4_v3:  ~$0.53/hour (~190 hours on $100 credit)
#    Always deallocate when not running benchmarks (`make azure-stop`).
#
# 5. Getting SSH Public Key:
#    cat ~/.ssh/id_rsa.pub
#    (Copy the entire output)
#
# ============================================================================
