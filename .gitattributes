# Force LF line endings for all text files so shell scripts work on WSL2/Linux/macOS
# regardless of git.autocrlf settings on the Windows host.

* text=auto eol=lf

# Explicitly LF for scripts and config
*.sh    text eol=lf
*.py    text eol=lf
*.env   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf

# Binary files — never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.gz    binary
*.zip   binary
*.tar   binary
